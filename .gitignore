# KAEDRA v0.1.0 .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
seeds/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Environments
.env*
!.env.example
.venv
env/
venv/
ENV/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# KAEDRA specific
.kaedra/
kaedra.log
*.db
*.db-journal
chat_logs/
memory/
config.json
cache/
sessions/

# Secrets - NEVER COMMIT
*.pem
*.key
credentials.json
service_account.json
kaedra/config/google_token.json
kaedra/config/google_oauth_client.json
kaedra/config/notion.toml
kaedra/config/ngrok.toml
kaedra/config/*.toml

# OS files
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp
*.bak
*_backup.py

# Debug scripts (may contain secrets)
debug_*.py
test_*.py
verify_*.py
.env
.env.*
